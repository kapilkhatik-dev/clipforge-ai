# Input used by main.py when no URL is passed to main.run().
CLIPPER_VIDEO_URL=https://www.youtube.com/watch?v=...

# Active AI backend: codex | nvidia | openrouter | openai | anthropic
# Keep the provider-specific model values below and change only this line to switch.
CLIPPER_LLM_PROVIDER=codex

# Provider-specific models. Only the active provider's value is used.
# codex/default omits --model and lets the installed CLI choose its recommended model.
CLIPPER_CODEX_MODEL=codex/default
CLIPPER_OPENROUTER_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
CLIPPER_NVIDIA_MODEL=nvidia_nim/nvidia/nemotron-3-ultra-550b-a55b
CLIPPER_OPENAI_MODEL=openai/gpt-4.1-mini
CLIPPER_ANTHROPIC_MODEL=anthropic/claude-sonnet-4-6

# OpenRouter credential used only when CLIPPER_LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=replace-with-your-openrouter-key

# Optional credentials for the other API providers. Codex ignores every API key.
# NVIDIA_NIM_API_KEY=replace-with-your-nvidia-key
# OPENAI_API_KEY=replace-with-your-openai-key
# ANTHROPIC_API_KEY=replace-with-your-anthropic-key

# Optional common overrides. Leave these unset for one-line provider switching.
# CLIPPER_LLM_MODEL takes precedence over every provider-specific model above.
# CLIPPER_LLM_MODEL=codex/gpt-5.6-sol
# CLIPPER_LLM_API_KEY=replace-with-the-active-api-provider-key

# Local Codex CLI settings; used only when CLIPPER_LLM_PROVIDER=codex.
CLIPPER_CODEX_BINARY=codex
CLIPPER_CODEX_TIMEOUT_SECONDS=300

# Optional FFmpeg discovery overrides. Normally PATH or FFMPEG_HOME is sufficient.
# FFMPEG_HOME=C:\ffmpeg\bin
# FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BINARY=C:\ffmpeg\bin\ffprobe.exe

# Deprecated compatibility alias. Prefer CLIPPER_LLM_MODEL.
# CLIPPER_MODEL=
